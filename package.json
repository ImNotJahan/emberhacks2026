{
  "name": "big-brother",
  "displayName": "Big Brother",
  "description": "Observes developer activity and decides when (rarely) to speak.",
  "version": "0.0.1",
  "publisher": "emberhacks",
  "engines": {
    "vscode": "^1.93.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bigBrother.menu",
        "title": "Big Brother: Menu"
      },
      {
        "command": "bigBrother.start",
        "title": "Big Brother: Start"
      },
      {
        "command": "bigBrother.stop",
        "title": "Big Brother: Stop"
      },
      {
        "command": "bigBrother.restart",
        "title": "Big Brother: Restart"
      },
      {
        "command": "bigBrother.showLog",
        "title": "Big Brother: Show Log"
      },
      {
        "command": "bigBrother.openDecisionLog",
        "title": "Big Brother: Open Decision Log"
      },
      {
        "command": "bigBrother.openDashboard",
        "title": "Big Brother: Open Dashboard"
      },
      {
        "command": "bigBrother.testNotification",
        "title": "Big Brother: Test Notification"
      },
      {
        "command": "bigBrother.openSidebar",
        "title": "Big Brother: Open Sidebar"
      }
    ],
    "configuration": {
      "title": "Big Brother",
      "properties": {
        "bigBrother.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start the capture engine and judge when VS Code starts."
        },
        "bigBrother.redaction.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Strip secrets (key/token/password string literals, .env contents) before anything leaves the editor process."
        },
        "bigBrother.python": {
          "type": "string",
          "default": "",
          "description": "Python executable for the capture engine and judge. Empty = auto-detect (.venv/venv in the extension folder, then python3, python, py)."
        },
        "bigBrother.port": {
          "type": "number",
          "default": 8765,
          "description": "Port for the local candidate-moment endpoint."
        },
        "bigBrother.testSurface.enabled": {
          "type": "boolean",
          "default": true,
          "description": "TEMPORARY: show judge decisions from logs/*.jsonl as notifications and in the status bar. Testing only."
        },
        "bigBrother.prompt": {
          "type": "string",
          "default": "judge-v8",
          "description": "Judge prompt version passed to judge.live (see judge/prompts.py). Empty = the judge's default."
        },
        "bigBrother.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Log every raw editor event to the Big Brother output channel (noisy)."
        }
      }
    },
    "views": {
      "bigBrother": [
        {
          "type": "webview",
          "id": "bigBrother.control",
          "name": "Control"
        },
        {
          "type": "webview",
          "id": "bigBrother.surface",
          "name": "Big Brother"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bigBrother",
          "title": "Big Brother",
          "icon": "media/bigbrother.svg"
        }
      ]
    }
  }
}
